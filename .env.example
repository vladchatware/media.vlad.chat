OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Vercel Blob - required for local dev / non-Vercel hosts.
# On Vercel, OIDC auth is automatic when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Renderer (defaults to http://localhost:3001)
RENDERER_URL=
# Shared secret; renderer requires `Authorization: Bearer <secret>` when set
RENDERER_SECRET=