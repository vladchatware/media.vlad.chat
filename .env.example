OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Vercel Blob - required for local dev / non-Vercel hosts.
# On Vercel, OIDC auth is automatic when a Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Shared secret; guards the renderer's local status API
RENDERER_SECRET=

# Render queue. The off-platform renderer and Vercel publisher must use tokens
# from the same project/environment scope.
VERCEL_QUEUE_REGION=iad1
VERCEL_RENDER_QUEUE_TOPIC=media-render
# Needed when publishing with the same off-platform token scope as the worker.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
