# Copy to workers/renderer/.env on worker machine.
# Shared secret; the app must send it as `Authorization: Bearer <secret>`
# (workflows/render.ts sends it when RENDERER_SECRET is set on the app).
RENDERER_SECRET=replace-with-a-shared-secret

# Recommended for reliable full-length SoundCloud HLS resolution. Without
# these, renderer falls back to music.vlad.chat's public stream endpoint.
ANALYSIS_SERVICE_SECRET=replace-with-analysis-service-secret
CONVEX_SITE_URL=https://replace-with-your-convex-site
# SOUNDCLOUD_USER_ID=

# Optional: pin a cloudflared image.
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
