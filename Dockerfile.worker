FROM oven/bun:1.3.8

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libgbm-dev \
    libasound2 \
    libxrandr2 \
    libxkbcommon-dev \
    libxfixes3 \
    libxcomposite1 \
    libxdamage1 \
    libatk-bridge2.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    libcups2 \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

RUN bunx remotion browser ensure

COPY remotion ./remotion
COPY public ./public
COPY renderer.ts ./renderer.ts
COPY render-worker.ts ./render-worker.ts
COPY tsconfig.json ./tsconfig.json

RUN mkdir -p /app/out

ENV PORT=3001
EXPOSE 3001

CMD ["bun", "run", "renderer.ts"]